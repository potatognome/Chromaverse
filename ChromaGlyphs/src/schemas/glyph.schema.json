{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chromaverse/schemas/glyph.schema.json",
  "title": "ChromaGlyph",
  "description": "A compact colour-palette glyph object (format version cg1).",
  "type": "object",
  "required": ["format", "meta", "palette"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "const": "cg1",
      "description": "Format version. Must be \"cg1\"."
    },
    "meta": {
      "type": "object",
      "required": ["id", "version", "created"],
      "additionalProperties": false,
      "description": "Glyph metadata block.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique glyph identifier (UUID v4 recommended)."
        },
        "version": {
          "type": "string",
          "const": "cg1",
          "description": "Internal version field. Must match the top-level format."
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 creation timestamp."
        },
        "author": {
          "type": "string",
          "description": "Optional author name or identifier."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional free-form tags."
        }
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "description": "Ordered array of colour entries.",
      "items": {
        "type": "object",
        "required": ["hex"],
        "additionalProperties": false,
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$",
            "description": "CSS hex colour, e.g. \"#FF6B6B\"."
          },
          "label": {
            "type": "string",
            "description": "Human-readable label for this colour."
          },
          "annotation": {
            "type": "string",
            "description": "Freeform annotation (usage note, mood tag, etc.)."
          }
        }
      }
    }
  }
}
